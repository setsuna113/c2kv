+C2KV_STRICT_NONFINITE_SAMPLING = "C2KV_STRICT_NONFINITE_SAMPLING"
+NONFINITE_LOGITS_ERROR_CODE = "C2KV_NATIVE_NONFINITE_LOGITS"
