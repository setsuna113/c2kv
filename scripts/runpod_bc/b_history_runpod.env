# RunPod H100 NVL (community) single-GPU layout for the B/C paired training.
# Sourced by agent/train_history_memory_h200.sh. One pod per arm; each pod runs
# NPROC_PER_NODE=1 with accumulation 16 so the effective batch stays 32.
G_REPO="/workspace"
GU_BASE="/workspace"
PYTHON_BIN="/workspace/c2kv-b-history/.venv-b-history/bin/python"
MODEL_NAME_OR_PATH="/workspace/models/Qwen3-4B-Instruct-2507"
DATA_PATH="/workspace/data/b_history"
OUTPUT_BASE="/workspace/checkpoints/b_history"

CUDA_VISIBLE_DEVICES="0"
NPROC_PER_NODE="1"
REQUIRE_H200="0"

# 1 GPU x per-device batch 2 x accumulation 16 = effective batch 32.
PER_DEVICE_BATCH_SIZE="2"
GRADIENT_ACCUMULATION_STEPS="16"
NUM_TRAIN_EPOCHS="2"
LEARNING_RATE="5e-5"
WEIGHT_DECAY="0.1"
WARMUP_RATIO="0.06"

RATIOS="4,8"
MAX_CHUNK_TOKENS="768"
CHUNK_OVERLAP="64"
MAX_SYSTEM_TOKENS="8192"
MAX_WORKSPACE_TOKENS="4096"
MAX_TARGET_TOKENS="4096"
MAX_CHUNKS="48"
ATTN_IMPL="sdpa"
BF16="true"

# Community-cloud host can be reclaimed; checkpoint every 250 updates
# (planned 1098 updates per arm -> 250/500/750/1000/1098, ~17 GB each).
SAVE_STEPS="250"
LOGGING_STEPS="1"
MAX_STEPS="-1"

WANDB_MODE="offline"
WANDB_ENTITY="liuyc1025-university-of-cambridge"
WANDB_PROJECT="c2kv-history-b"
WANDB_DIR="/workspace/checkpoints/b_history/wandb"

SEEDS="42"
