+def run_task_isolated(task_id: str, output_dir: str, **kwargs):
+    """Run one task once and turn only typed generation failures into audit data."""
+    try:
+        return main(task_id=task_id, output_dir=output_dir, **kwargs), None
+    except AppWorldGenerationError as exc:
+        results_path = Path(output_dir) / "results.json"
+        try:
+            result = json.loads(results_path.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError) as artifact_error:
+            raise RuntimeError(
+                f"generation failure for {task_id} lacks a valid results.json"
+            ) from artifact_error
+        if result.get("termination_reason") != "generation_error":
+            raise RuntimeError(
+                f"generation failure for {task_id} lacks typed task evidence"
+            ) from exc
+        return None, {
+            "task_id": task_id,
+            "failure_type": "generation_error",
+            "error_type": type(exc).__name__,
+            "error": result.get("error") or str(exc),
+            "results_path": str(results_path.resolve()),
+            "task_attempts": 1,
+            "failed_request_retries": 0,
+        }
+
