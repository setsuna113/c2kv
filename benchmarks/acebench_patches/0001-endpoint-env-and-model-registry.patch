diff --git a/model_inference/role_history.py b/model_inference/role_history.py
new file mode 100644
index 0000000..8f7abe3
--- /dev/null
+++ b/model_inference/role_history.py
@@ -0,0 +1,177 @@
+"""Role-preserving OpenAI messages for ACEBench agent clients."""
+
+import json
+import os
+
+
+TEXT_ACTIONS_ENV = "ACEBENCH_TEXT_ACTIONS_V1"
+ROLE_HISTORY_ENV = "ACEBENCH_ROLE_HISTORY_V1"
+EVENT_NATIVE_ENV = "ACEBENCH_EVENT_NATIVE_V1"
+SOURCE_VERSION = "acebench-text-actions-v1"
+RECEIPT_VERSION = "acebench-execution-receipt-v1"
+RECEIPT_FIELDS = (
+    "version",
+    "agent_history_index",
+    "decode_status",
+    "decoded_calls",
+    "executor_status",
+    "executor_return_shape",
+    "executor_return_count",
+)
+
+
+def _content(value):
+    if isinstance(value, str):
+        return value
+    return json.dumps(value, ensure_ascii=False)
+
+
+def dialogue_coordinates(history):
+    """Return the stable agent-decision coordinate of a structured prefix."""
+    if not isinstance(history, list):
+        raise TypeError("ACEBench role history must be a list")
+    user_turn = -1
+    step = 0
+    for entry in history:
+        if not isinstance(entry, dict):
+            raise TypeError("ACEBench role history entries must be dictionaries")
+        sender = entry.get("sender")
+        if sender == "user":
+            user_turn += 1
+            step = 0
+        elif sender == "agent":
+            if user_turn < 0:
+                raise ValueError("ACEBench role history must start with a user turn")
+            step += 1
+        elif sender == "execution":
+            if user_turn < 0:
+                raise ValueError("ACEBench role history must start with a user turn")
+        else:
+            raise ValueError(f"unknown ACEBench dialogue sender: {sender!r}")
+    if user_turn < 0:
+        raise ValueError("ACEBench role history must contain a user turn")
+    return user_turn, step
+
+
+def eval_context(task_id, history=None):
+    """Build the exact identity consumed by C2KV benchmark endpoints."""
+    if not isinstance(task_id, str) or not task_id:
+        raise ValueError("ACEBench task_id must be a nonempty string")
+    user_turn, step = ((0, 0) if history is None
+                       else dialogue_coordinates(history))
+    return {
+        "benchmark": "acebench",
+        "task_id": task_id,
+        "user_turn": user_turn,
+        "step": step,
+        "attempt": 0,
+    }
+
+
+def text_actions_enabled():
+    """Return the explicit receipt bridge flag after checking its prerequisites."""
+    enabled = os.getenv(TEXT_ACTIONS_ENV) == "1"
+    if enabled and (os.getenv(ROLE_HISTORY_ENV) != "1"
+                    or os.getenv(EVENT_NATIVE_ENV) != "1"):
+        raise ValueError(
+            "ACEBENCH_TEXT_ACTIONS_V1 requires ACEBENCH_ROLE_HISTORY_V1=1 "
+            "and ACEBENCH_EVENT_NATIVE_V1=1"
+        )
+    return enabled
+
+
+def execution_receipts(history):
+    """Return source receipts for the current structured prefix, if any."""
+    if history is None:
+        return []
+    if not isinstance(history, list):
+        raise TypeError("ACEBench role history must be a list")
+    receipts = []
+    for history_index, entry in enumerate(history):
+        if not isinstance(entry, dict) or entry.get("sender") != "execution":
+            continue
+        receipt = entry.get("c2kv_acebench_execution")
+        if not isinstance(receipt, dict):
+            raise ValueError("ACEBench execution history requires a receipt")
+        if receipt.get("version") != RECEIPT_VERSION:
+            raise ValueError("ACEBench execution receipt version mismatch")
+        if receipt.get("execution_message_index") != history_index + 1:
+            raise ValueError("ACEBench execution receipt source index mismatch")
+        if (not isinstance(receipt.get("agent_history_index"), int)
+                or receipt["agent_history_index"] != history_index - 1):
+            raise ValueError("ACEBench execution receipt agent index mismatch")
+        copied = {field: receipt.get(field) for field in RECEIPT_FIELDS}
+        copied["execution_message_index"] = receipt["execution_message_index"]
+        receipts.append(copied)
+    return receipts
+
+
+def bind_execution_receipt(history, current_message):
+    """Bind a receipt to the scene index immediately before the observation appends."""
+    if not text_actions_enabled() or current_message.get("sender") != "execution":
+        return
+    receipt = current_message.get("c2kv_acebench_execution")
+    if not isinstance(receipt, dict):
+        raise ValueError("ACEBench execution observation omitted its receipt")
+    if not history or history[-1].get("sender") != "agent":
+        raise ValueError("ACEBench execution observation must follow an agent message")
+    receipt["agent_history_index"] = len(history) - 1
+    # `history` is about to receive this execution entry.  OpenAI source
+    # messages have a system prompt at index zero, hence history index + 1.
+    receipt["execution_message_index"] = len(history) + 1
+
+
+def agent_request(messages, model, temperature, max_tokens, top_p, context, history=None):
+    """Keep generic proxy kwargs, with an explicit event-native opt-in."""
+    kwargs = {
+        "messages": messages,
+        "model": model,
+        "temperature": temperature,
+        "max_tokens": max_tokens,
+        "top_p": top_p,
+        "extra_body": {"c2kv_eval_context": context},
+    }
+    if os.getenv("ACEBENCH_EVENT_NATIVE_V1") == "1":
+        if float(temperature) != 0.0 or float(top_p) != 1.0:
+            raise ValueError(
+                "ACEBENCH_EVENT_NATIVE_V1 requires temperature=0 and top_p=1"
+            )
+        kwargs.pop("max_tokens")
+        kwargs.pop("top_p")
+        kwargs.update(
+            max_completion_tokens=max_tokens,
+            store=False,
+            seed=0,
+        )
+    if text_actions_enabled():
+        kwargs["extra_body"]["c2kv_ace_source"] = {
+            "version": SOURCE_VERSION,
+            "receipts": execution_receipts(history),
+        }
+    return kwargs
+
+
+def agent_messages(system_prompt, functions, history, language="en"):
+    """Convert the scene's structured history without parsing transcript text."""
+    if not isinstance(history, list):
+        raise TypeError("ACEBench role history must be a list")
+    if language == "zh":
+        api_heading = "下面是你可使用的 API 列表："
+    else:
+        api_heading = "Below is the list of APIs you can use:"
+    messages = [{
+        "role": "system",
+        "content": system_prompt.rstrip() + "\n\n" + api_heading + "\n" + _content(functions),
+    }]
+    roles = {"user": "user", "agent": "assistant", "execution": "tool"}
+    for index, entry in enumerate(history):
+        sender = entry.get("sender")
+        if sender not in roles:
+            raise ValueError(f"unknown ACEBench dialogue sender: {sender!r}")
+        message = {"role": roles[sender], "content": _content(entry.get("message"))}
+        if sender == "execution":
+            # The C2KV proxy consumes this identifier while normalizing tool
+            # observations to the checkpoint's user-message training dialect.
+            message["tool_call_id"] = f"acebench-execution-{index}"
+        messages.append(message)
+    return messages
