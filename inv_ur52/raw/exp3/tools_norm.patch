+def _normalize_tool_for_sglang(tool: dict[str, Any]) -> dict[str, Any]:
+    # Mirror sglang Tool/Function.model_dump() exactly: the server parses the
+    # HTTP payload through pydantic (dropping unknown keys like "response",
